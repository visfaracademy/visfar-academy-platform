# Visfar Academy — bien moi truong frontend (CHI ANON KEY, xem ghi chu)
# Copy file nay thanh .env.local va dien gia tri that. KHONG commit .env.local.
# NGUYEN TAC: frontend CHI DUOC dung anon key. Service-role key KHONG BAO GIO
# xuat hien o day — no chi nam trong Cloudflare Workers Secrets (Module 2+).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Workers API — URL Worker moi (doi ten 11/11/2026).
# Alias da chot van la visfaracademy.netlify.app/api/v1 (DECISIONS Task 02
# QĐ 8) nhung chi dung duoc sau khi co redirect Netlify ve Worker moi.
NEXT_PUBLIC_API_BASE_URL=https://api.visfaracademy.workers.dev/api/v1

# Endpoint Apps Script CU (fallback co ghi log — xem src/lib/leads.ts).
# URL cong khai co san trong trang hien tai; giu nguyen cho toi khi API
# moi duoc chung minh on dinh bang dang ky that + doi soat. KHONG xoa
# truoc khi du 3 dieu kien o docs/frontend/TASK05_REPORT.md §6.
NEXT_PUBLIC_LEGACY_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxMYvos2_UjIC9AQHnbA_I4F2gAIntnzmjkL6bWv4Doq26ltrfA6T0BpkONdesQk-fM/exec

# Cloudflare Turnstile — CHUA co site key (can user cung cap sau).
# Khi chua co key, form gui khong kem token; server ap rate-limit chat
# hon + ghi log theo DECISIONS Task 03 QĐ 13, khong chan cung nguoi that.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# GA4 + Meta Pixel (Prompt 15, GĐ2) — CHUA CO ID THAT.
# Chi dien ID that khi user cung cap; khi trong, khong co tracking nao
# duoc bat (xem src/lib/analytics.ts + src/components/analytics/Analytics.tsx).
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000
